name: Build recroll x64

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - "recroll/**"
      - "recroll.sln"
      - ".github/workflows/build-recroll.yml"

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout recroll
        uses: actions/checkout@v4

      - name: Checkout custom HDT
        uses: actions/checkout@v4
        with:
          repository: papaigr228VIP/HDT-DEMOCRATION
          ref: master
          path: hdt-source

      - name: Setup MSBuild
        uses: microsoft/setup-msbuild@v2

      - name: Bootstrap HDT dependencies
        shell: powershell
        working-directory: hdt-source
        run: ./bootstrap.ps1

      - name: Update HDT build version
        shell: powershell
        working-directory: hdt-source
        run: |
          ./build-scripts/update_version.ps1 -dev $true -buildNumber $Env:GITHUB_RUN_NUMBER

      - name: Build custom HDT x64
        shell: powershell
        working-directory: hdt-source
        run: |
          msbuild ".\Hearthstone Deck Tracker.sln" /m /p:Configuration=Release /p:Platform="x64"

      - name: Copy HDT reference
        shell: powershell
        run: |
          $releaseDir = Join-Path $env:GITHUB_WORKSPACE "hdt-source\Hearthstone Deck Tracker\bin\x64\Release"
          $referenceDir = Join-Path $env:GITHUB_WORKSPACE "recroll\Reference"

          New-Item -ItemType Directory -Force -Path $referenceDir | Out-Null

          $hdt = Get-ChildItem -Path $releaseDir -Recurse -File -Filter "HearthstoneDeckTracker.exe" | Select-Object -First 1

          if (-not $hdt) {
            throw "HearthstoneDeckTracker.exe was not found."
          }

          Copy-Item $hdt.FullName (Join-Path $referenceDir "HearthstoneDeckTracker.exe") -Force

      - name: Build recroll x64
        shell: powershell
        run: |
          msbuild ".\recroll.sln" /m /restore /p:Configuration=Release /p:Platform="x64"

      - name: Prepare artifact
        shell: powershell
        run: |
          $dll = ".\recroll\bin\x64\Release\recroll.dll"

          if (-not (Test-Path $dll)) {
            throw "recroll.dll was not produced."
          }

          New-Item -ItemType Directory -Force -Path ".\artifact" | Out-Null
          Copy-Item $dll ".\artifact\recroll.dll" -Force

      - name: Upload recroll x64
        uses: actions/upload-artifact@v4
        with:
          name: recroll-x64
          path: artifact/recroll.dll
          retention-days: 30
